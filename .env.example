# Copy to `.env` and fill in values. `.env*` is ignored by git (except this file).

# Backend SSH access (preferred: use SSH keys and omit PASS)
TAJIRI_BACKEND_SSH_HOST=
TAJIRI_BACKEND_SSH_USER=root
TAJIRI_BACKEND_REMOTE_PATH=/var/www/tajiri.zimasystems.com

# Tajiri Laravel MySQL (from production `DB_*` vars)
TAJIRI_DB_HOST=localhost
TAJIRI_DB_PORT=3306
TAJIRI_DB_DATABASE=johndoe_database
TAJIRI_DB_USERNAME=johndoe_dbuser

# Sensitive — keep only in `.env`
TAJIRI_BACKEND_SSH_PASS=
TAJIRI_DB_PASSWORD=
